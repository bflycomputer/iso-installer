input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 25
    }

    touchpad {
        tap
        natural-scroll
    }
}

// The installer supports pointer and keyboard input equally. Never hide the
// pointer after keyboard input: on a fullscreen installer that makes it look
// as though mouse support disappeared until the pointer is moved again.
cursor {
    xcursor-theme "capitaine-cursors"
    xcursor-size 24
}

layout {
    gaps 0

    focus-ring {
        off
    }

    border {
        off
    }
}

spawn-at-startup "sudo" "/usr/local/bin/pond-installer"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path null

animations {
    off
}
